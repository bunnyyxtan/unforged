{
  "name": "@unforged/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Compact contract, witnesses and simulator tests for Unforged.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "compact": "compactc --feature-zkir-v3 --skip-zk src/unforged.compact src/managed/unforged && npm run compact:28",
    "compact:28": "node scripts/variant.mjs 28 && compactc --feature-zkir-v3 --skip-zk src/unforged28.compact src/managed/unforged28",
    "compact:keys": "compactc --feature-zkir-v3 src/unforged.compact src/managed/unforged",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.20.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
